    {"metric": "allowed_fact_usage_rate", "operator": "==", "threshold": 1.0},
    {"metric": "unsupported_claim_rate", "operator": "==", "threshold": 0.0},
    {"metric": "fabricated_identifier_rate", "operator": "==", "threshold": 0.0},
    {"metric": "fabricated_schedule_rate", "operator": "==", "threshold": 0.0},
    {"metric": "unauthorized_promise_rate", "operator": "==", "threshold": 0.0},
    {"metric": "deterministic_template_compliance", "operator": "==", "threshold": 1.0},
    {"metric": "technical_leakage_rate", "operator": "==", "threshold": 0.0},
    {"metric": "safety_template_compliance", "operator": "==", "threshold": 1.0}
  ]
