{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-case-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "case_version", "suite", "severity", "locale", "tags", "description", "input", "expected", "forbidden"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "case_version": {"type": "integer", "minimum": 1},
    "suite": {"type": "string"},
    "severity": {"enum": ["STANDARD", "CRITICAL"]},
    "locale": {"const": "zh-CN"},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "description": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "expected": {"type": "object"},
    "forbidden": {"type": "object"}
  }
}
