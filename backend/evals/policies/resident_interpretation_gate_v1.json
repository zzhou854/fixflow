    {"metric": "tool_call_count", "operator": "delta<=", "threshold": 0.0, "severity": "HARD"},
    {"metric": "schema_pass_rate", "operator": "delta>=", "threshold": -0.005, "severity": "HARD"},
    {"metric": "intent_accuracy", "operator": "delta>=", "threshold": -0.01, "severity": "HARD"},
