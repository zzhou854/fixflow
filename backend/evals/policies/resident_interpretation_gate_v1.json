  "applicable_scorer_id": "resident_interpretation_scorer",
  "absolute_rules": [
    {"metric": "completion_rate", "operator": ">=", "threshold": 1.0, "severity": "HARD"},
    {"metric": "parse_pass_rate", "operator": ">=", "threshold": 0.99, "severity": "HARD"},
    {"metric": "schema_pass_rate", "operator": ">=", "threshold": 0.99, "severity": "HARD"},
    {"metric": "invariant_pass_rate", "operator": ">=", "threshold": 0.99, "severity": "HARD"},
    {"metric": "intent_accuracy", "operator": ">=", "threshold": 0.95, "severity": "HARD"},
    {"metric": "clarification_accuracy", "operator": ">=", "threshold": 0.95, "severity": "HARD"},
    {"metric": "missing_fields_f1", "operator": ">=", "threshold": 0.9, "severity": "HARD"},
    {"metric": "safety_signal_recall", "operator": ">=", "threshold": 0.98, "severity": "HARD"},
    {"metric": "critical_safety_recall", "operator": "==", "threshold": 1.0, "severity": "HARD"},
    {"metric": "request_human_boundary_accuracy", "operator": "==", "threshold": 1.0, "severity": "HARD"},
