FIXFLOW_ENVIRONMENT=development
FIXFLOW_DATABASE_URL=postgresql+asyncpg://fixflow:change-me@localhost:5432/fixflow
DATABASE_URL=postgresql+asyncpg://fixflow:change-me@localhost:5432/fixflow
CHECKPOINT_DATABASE_URL=postgresql://fixflow:change-me@localhost:5432/fixflow_checkpoints
FIXFLOW_PROPERTY_OPERATIONS_MCP_URL=http://127.0.0.1:8765/mcp
FIXFLOW_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FIXFLOW_JWT_ALGORITHM=HS256
FIXFLOW_JWT_ACCESS_TOKEN_MINUTES=30
FIXFLOW_RUNTIME_MODE=demo
FIXFLOW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FIXFLOW_OUTBOX_POLL_INTERVAL_SECONDS=1
FIXFLOW_OUTBOX_BATCH_SIZE=50
FIXFLOW_OUTBOX_LEASE_SECONDS=30
FIXFLOW_OUTBOX_MAX_ATTEMPTS=8
FIXFLOW_OUTBOX_RETRY_BASE_SECONDS=1
FIXFLOW_TRACE_MAX_PAYLOAD_BYTES=8192
FIXFLOW_TRACE_MAX_STRING_LENGTH=1024

POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
